# ---------------------------------------------
# Directory index
# ---------------------------------------------
DirectoryIndex index.html index.htm

# ---------------------------------------------
# Canonical domain: force HTTPS + non-www
# ---------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Only apply to the real domain (avoid breaking temporary/staging hostnames)
  RewriteCond %{HTTP_HOST} ^(www\.)?baarsglasengevelwerken\.nl$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://baarsglasengevelwerken.nl%{REQUEST_URI} [R=301,L]

  # ---------------------------------------------
  # Remove .html from URLs (clean URLs)
  # ---------------------------------------------

  # Redirect requests containing .html → clean
  RewriteCond %{THE_REQUEST} "\s/([^.]+)\.html[\s?]" [NC]
  RewriteRule ^ %1 [R=301,L]

  # Serve the .html file when extensionless URL exists
  # Skip if request is for root directory
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# ---------------------------------------------
# Caching rules
# ---------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"

  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# ---------------------------------------------
# Cache control headers
# ---------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---------------------------------------------
# Gzip compression
# ---------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml text/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

