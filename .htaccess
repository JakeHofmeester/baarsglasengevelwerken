# display the default page
directoryindex index.php index.php4 index.php5 index.phtml index.html index.htm index.shtml default.html default.htm index.ehtml /____groupone_default/default.shtml

# ------------------------------------------------------------
# canonical: force https + non-www for baarsglasengevelwerken.nl
# ------------------------------------------------------------
<ifmodule mod_rewrite.c>
  rewriteengine on

  rewritecond %{http_host} ^(www\.)?baarsglasengevelwerken\.nl$ [nc]
  rewritecond %{https} !=on [or]
  rewritecond %{http_host} ^www\. [nc]
  rewriterule ^ https://baarsglasengevelwerken.nl%{request_uri} [r=301,l]
</ifmodule>

# ------------------------------------------------------------
# redirect index.html to root
# ------------------------------------------------------------
<ifmodule mod_rewrite.c>
  rewritecond %{the_request} \s/+index\.html[\s?]
  rewriterule ^index\.html$ / [r=301,l]
</ifmodule>

# -------------------------
# static asset caching
# -------------------------
<ifmodule mod_expires.c>
  expiresactive on
  expiresdefault "access plus 1 week"

  expiresbytype text/css "access plus 1 year"
  expiresbytype application/javascript "access plus 1 year"
  expiresbytype application/x-javascript "access plus 1 year"

  expiresbytype image/webp "access plus 1 year"
  expiresbytype image/png "access plus 1 year"
  expiresbytype image/jpeg "access plus 1 year"
  expiresbytype image/svg+xml "access plus 1 year"
  expiresbytype image/x-icon "access plus 1 year"

  expiresbytype font/woff2 "access plus 1 year"
  expiresbytype font/woff "access plus 1 year"
  expiresbytype application/font-woff2 "access plus 1 year"
  expiresbytype application/font-woff "access plus 1 year"
  expiresbytype application/vnd.ms-fontobject "access plus 1 year"
  expiresbytype font/ttf "access plus 1 year"
</ifmodule>

<ifmodule mod_headers.c>
  <filesmatch "\.(css|js)$">
    header set cache-control "public, max-age=604800"
  </filesmatch>

  <filesmatch "\.(webp|png|jpe?g|gif|svg|ico|woff2?|ttf|eot)$">
    header set cache-control "public, max-age=31536000, immutable"
  </filesmatch>

  <filesmatch "\.(html?)$">
    header set cache-control "no-cache"
  </filesmatch>
</ifmodule>

# -------------------------
# gzip compression
# -------------------------
<ifmodule mod_deflate.c>
  addoutputfilterbytype deflate text/html text/plain text/css
  addoutputfilterbytype deflate application/javascript application/x-javascript
  addoutputfilterbytype deflate application/json application/xml text/xml
  addoutputfilterbytype deflate image/svg+xml
</ifmodule>

# ------------------------------------------------------------
# redirect old .html URLs to new folder structure
# ------------------------------------------------------------
<ifmodule mod_rewrite.c>
  rewriteengine on

  rewritecond %{the_request} \s/+diensten\.html[\s?]
  rewriterule ^diensten\.html$ /diensten/ [r=301,l]
  
  rewritecond %{the_request} \s/+gevelreiniging\.html[\s?]
  rewriterule ^gevelreiniging\.html$ /gevelreiniging/ [r=301,l]
  
  rewritecond %{the_request} \s/+glasbewassing\.html[\s?]
  rewriterule ^glasbewassing\.html$ /glasbewassing/ [r=301,l]
  
  rewritecond %{the_request} \s/+impregneren\.html[\s?]
  rewriterule ^impregneren\.html$ /impregneren/ [r=301,l]
  
  rewritecond %{the_request} \s/+kozijnen-conserveren\.html[\s?]
  rewriterule ^kozijnen-conserveren\.html$ /kozijnen-conserveren/ [r=301,l]
  
  rewritecond %{the_request} \s/+reinigingsdiensten\.html[\s?]
  rewriterule ^reinigingsdiensten\.html$ /reinigingsdiensten/ [r=301,l]
  
  rewritecond %{the_request} \s/+spinnenweren\.html[\s?]
  rewriterule ^spinnenweren\.html$ /spinnenweren/ [r=301,l]
  
  rewritecond %{the_request} \s/+privacy\.html[\s?]
  rewriterule ^privacy\.html$ /privacy/ [r=301,l]
  
  rewritecond %{the_request} \s/+cookies\.html[\s?]
  rewriterule ^cookies\.html$ /cookies/ [r=301,l]
</ifmodule>
