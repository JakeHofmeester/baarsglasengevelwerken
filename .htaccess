# ---------------------------------------------
# directory index + branded 404
# ---------------------------------------------
directoryindex index.html index.htm
ErrorDocument 404 /404.html

# ---------------------------------------------
# canonical domain: force https + non-www + no trailing slash
# ---------------------------------------------
<ifmodule mod_rewrite.c>
  rewriteengine on

  # only apply to the real domain
  rewritecond %{http_host} ^(www\.)?baarsglasengevelwerken\.nl$ [nc]

  # force https or non-www
  rewritecond %{https} !=on [or]
  rewritecond %{http_host} ^www\. [nc]
  rewriterule ^ https://baarsglasengevelwerken.nl%{request_uri} [r=301,l]

  # remove trailing slash from all urls except root
  rewritecond %{request_uri} !^/$
  rewritecond %{request_uri} .+/$
  rewriterule ^(.+)/$ /$1 [r=301,l]

  # ---------------------------------------------
  # old homepage section links (?go=...) -> real pages / anchors
  # ?go=contact (also with Google's rwg_token) -> /contact, other ?go=x -> /#x
  # ---------------------------------------------
  rewritecond %{query_string} (^|&)go=contact(&|$) [nc]
  rewriterule ^(index\.html)?$ /contact? [r=301,l]

  rewritecond %{query_string} (^|&)go=([a-z0-9-]+)(&|$) [nc]
  rewriterule ^(index\.html)?$ /#%2? [ne,r=301,l]

  # ---------------------------------------------
  # merged pages
  # ---------------------------------------------
  rewriterule ^dak-impregneren(\.html)?$ /dak-reinigen#impregneren [ne,r=301,l]

  # ---------------------------------------------
  # remove .html from urls (public); index.html -> /
  # (the leading slash in the target is required: without it apache
  # prefixes the document root and the redirect ends on a 404)
  # ---------------------------------------------
  rewritecond %{the_request} "\s/+index\.html[\s?]" [nc]
  rewriterule ^ / [r=301,l]

  rewritecond %{the_request} "\s/([^.\s?]+)\.html[\s?]" [nc]
  rewriterule ^ /%1 [r=301,l]

  # ---------------------------------------------
  # map clean urls internally to .html files
  # (a .html file wins over a folder with the same name, e.g. kennisbank.html vs kennisbank/)
  # ---------------------------------------------
  rewritecond %{request_filename}\.html -f
  rewriterule ^(.+)$ $1.html [l]
</ifmodule>

# ---------------------------------------------
# security headers
# ---------------------------------------------
<ifmodule mod_headers.c>
  header always set strict-transport-security "max-age=31536000; includeSubDomains"
  header always set x-content-type-options "nosniff"
  header always set referrer-policy "strict-origin-when-cross-origin"
  header always set x-frame-options "SAMEORIGIN"
</ifmodule>

# ---------------------------------------------
# caching rules
# ---------------------------------------------
<ifmodule mod_expires.c>
  expiresactive on
  expiresdefault "access plus 1 week"

  expiresbytype text/css "access plus 1 year"
  expiresbytype application/javascript "access plus 1 year"
  expiresbytype application/x-javascript "access plus 1 year"

  expiresbytype image/webp "access plus 1 year"
  expiresbytype image/png  "access plus 1 year"
  expiresbytype image/jpeg "access plus 1 year"
  expiresbytype image/svg+xml "access plus 1 year"
  expiresbytype image/x-icon "access plus 1 year"

  expiresbytype font/woff2 "access plus 1 year"
  expiresbytype font/woff  "access plus 1 year"
  expiresbytype application/vnd.ms-fontobject "access plus 1 year"
  expiresbytype font/ttf "access plus 1 year"
</ifmodule>

# ---------------------------------------------
# cache control headers
# css/js are referenced with ?v=yyyymmdd, so a new version is fetched after every change
# ---------------------------------------------
<ifmodule mod_headers.c>
  <filesmatch "\.(css|js)$">
    header set cache-control "public, max-age=604800"
  </filesmatch>

  <filesmatch "\.(webp|png|jpe?g|gif|svg|ico|woff2?|ttf|eot)$">
    header set cache-control "public, max-age=31536000, immutable"
  </filesmatch>

  <filesmatch "\.(html?|txt|xml)$">
    header set cache-control "no-cache"
  </filesmatch>
</ifmodule>

# ---------------------------------------------
# gzip compression
# ---------------------------------------------
<ifmodule mod_deflate.c>
  addoutputfilterbytype deflate text/html text/plain text/css
  addoutputfilterbytype deflate application/javascript application/x-javascript
  addoutputfilterbytype deflate application/json application/xml text/xml
  addoutputfilterbytype deflate image/svg+xml
</ifmodule>
